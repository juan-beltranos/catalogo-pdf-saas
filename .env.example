# Variables públicas usadas por Next.js en el navegador
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Variables privadas: solo están disponibles en las rutas del servidor
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://media.example.com
APP_ORIGIN=https://app.example.com

# Un enlace de registro por versión: https://app.example.com/?token=VALOR
REGISTRATION_TOKEN_BASIC=basic_cambia_este_token
REGISTRATION_TOKEN_PRO=pro_cambia_este_token
REGISTRATION_TOKEN_PREMIUM=premium_cambia_este_token

# Los nombres VITE_PUBLIC_SUPABASE_URL y VITE_PUBLIC_SUPABASE_ANON_KEY
# existentes también son aceptados por next.config.ts durante la transición.
